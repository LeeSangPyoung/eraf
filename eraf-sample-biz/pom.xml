<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.11</version>
        <relativePath/>
    </parent>

    <groupId>com.eraf</groupId>
    <artifactId>eraf-sample-biz</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>ERAF Sample Business Application</name>
    <description>Sample application demonstrating all ERAF framework features (67 UI features)</description>

    <properties>
        <java.version>21</java.version>
        <eraf.version>1.0.0-SNAPSHOT</eraf.version>
    </properties>

    <dependencies>
        <!-- ===== ERAF Core ===== -->
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-core</artifactId>
            <version>${eraf.version}</version>
        </dependency>

        <!-- ===== ERAF Web ===== -->
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-web</artifactId>
            <version>${eraf.version}</version>
        </dependency>
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-security</artifactId>
            <version>${eraf.version}</version>
        </dependency>
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-session</artifactId>
            <version>${eraf.version}</version>
        </dependency>
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-swagger</artifactId>
            <version>${eraf.version}</version>
        </dependency>

        <!-- ===== ERAF Data ===== -->
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-data-jpa</artifactId>
            <version>${eraf.version}</version>
        </dependency>
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-data-mybatis</artifactId>
            <version>${eraf.version}</version>
        </dependency>
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-data-redis</artifactId>
            <version>${eraf.version}</version>
        </dependency>
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-data-elasticsearch</artifactId>
            <version>${eraf.version}</version>
        </dependency>
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-data-cache</artifactId>
            <version>${eraf.version}</version>
        </dependency>

        <!-- ===== ERAF Messaging ===== -->
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-messaging-kafka</artifactId>
            <version>${eraf.version}</version>
        </dependency>
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-messaging-rabbitmq</artifactId>
            <version>${eraf.version}</version>
        </dependency>

        <!-- ===== ERAF Integration ===== -->
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-integration-ftp</artifactId>
            <version>${eraf.version}</version>
        </dependency>
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-integration-tcp</artifactId>
            <version>${eraf.version}</version>
        </dependency>
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-integration-s3</artifactId>
            <version>${eraf.version}</version>
        </dependency>
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-integration-http</artifactId>
            <version>${eraf.version}</version>
        </dependency>

        <!-- ===== ERAF Processing ===== -->
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-batch</artifactId>
            <version>${eraf.version}</version>
        </dependency>
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-scheduler</artifactId>
            <version>${eraf.version}</version>
        </dependency>
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-statemachine</artifactId>
            <version>${eraf.version}</version>
        </dependency>
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-saga</artifactId>
            <version>${eraf.version}</version>
        </dependency>
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-notification</artifactId>
            <version>${eraf.version}</version>
        </dependency>
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-actuator</artifactId>
            <version>${eraf.version}</version>
        </dependency>

        <!-- ===== ERAF Document & Media ===== -->
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-excel</artifactId>
            <version>${eraf.version}</version>
        </dependency>
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-pdf</artifactId>
            <version>${eraf.version}</version>
        </dependency>
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-barcode</artifactId>
            <version>${eraf.version}</version>
        </dependency>
        <dependency>
            <groupId>com.eraf</groupId>
            <artifactId>eraf-image</artifactId>
            <version>${eraf.version}</version>
        </dependency>

        <!-- ===== Spring Boot Starters ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- DevTools -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.36</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
